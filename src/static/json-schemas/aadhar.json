{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aadhaar Card",
  "description": "Basic Aadhaar card information.",
  "type": "object",
  "required": [
    "name",
    "aadhaarNumber",
    "phoneNumber"
  ],
  "properties": {
    "name": {
      "type": "string",
      "title": "Full Name",
      "description": "Enter your full name as on Aadhaar.",
      "minLength": 3,
      "maxLength": 100
    },
    "aadhaarNumber": {
      "type": "string",
      "title": "Aadhaar Number",
      "description": "Enter your 12-digit Aadhaar number.",
      "pattern": "^[0-9]{12}$"
    },
    "phoneNumber": {
      "type": "string",
      "title": "Phone Number",
      "description": "Enter your 10-digit mobile number.",
      "pattern": "^[6-9][0-9]{9}$"
    }
  }
}
